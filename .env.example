# Stripe restricted key (Invoices: Read only). Never commit the real value.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=https://bmpestcontrol.ca

# Address suggestions + address check (Mapbox Geocoding). Optional: without it, suggestions are off and the check falls back to OpenStreetMap.
MAPBOX_ACCESS_TOKEN=

# Quote requests from the calculator (Resend). Without these, the form shows a "call us" message.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
